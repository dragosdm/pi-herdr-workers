{
  "name": "pi-herdr-workers",
  "version": "0.2.0",
  "description": "Pi + Herdr: /team, /loop, monitors, /split-handoff and /split-fork. No extra npm deps.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tobi/pi-herdr-workers.git"
  },
  "keywords": ["pi-package", "pi", "herdr", "loop", "monitor"],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts"
  },
  "pi": {
    "extensions": [
      "./extensions/herdr-worker.ts",
      "./extensions/split-handoff.ts",
      "./loop/index.ts"
    ]
